#!/bin/sh
# pre-push — chan push thang len origin/main tru khi co bien ALLOW_PUSH_MAIN=1.
#
# Ly do: repo public, main la nhanh prod (server 8081 chay tu working dir).
# Quy trinh duyet: lam viec tren nhanh rieng -> merge vao main -> push.
#
# Van co the vuot bang `git push --no-verify` — day chi la lop cuc bo.
# Lop chac chan la branch protection phia GitHub (bat buoc PR).
#
# Cach dung: ALLOW_PUSH_MAIN=1 git push origin main   (khi da duoc duyet)

zero='0000000000000000000000000000000000000000'
blocked=0

while read local_ref local_sha remote_ref remote_sha; do
    # Bo qua xoa nhanh
    [ "$local_sha" = "$zero" ] && continue
    if [ "$remote_ref" = "refs/heads/main" ]; then
        if [ "${ALLOW_PUSH_MAIN:-}" = "1" ]; then
            echo "pre-push: CHO PHEP push len main (ALLOW_PUSH_MAIN=1)." >&2
        else
            echo "pre-push: CHAN push len refs/heads/main." >&2
            echo "  Lam viec tren nhanh rieng, merge vao main, roi push." >&2
            echo "  Neu da duoc duyet ro rang: ALLOW_PUSH_MAIN=1 git push origin main" >&2
            blocked=1
        fi
    fi
done

exit $blocked
