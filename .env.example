APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
POS_BANK_CODE=
POS_BANK_ACCOUNT=
POS_BANK_NAME="Cửa hàng phụ kiện điện thoại"
POS_QR_TEMPLATE=compact2
POS_CHO_THANH_TOAN_PHUT=15
SEPAY_WEBHOOK_API_KEY=
# Đối soát chủ động: khóa này KHÁC SEPAY_WEBHOOK_API_KEY (ta gọi SePay, chỉ đọc).
SEPAY_API_TOKEN=
SEPAY_API_BASE_URL=https://userapi.sepay.vn/v2
SEPAY_API_VERSION=v2
SEPAY_API_TIMEOUT=15
SEPAY_API_RETRIES=3
# Số tin Telegram chi tiết mỗi lần chạy đối soát; phần vượt gộp thành một tin.
SEPAY_DOI_SOAT_TELEGRAM_TOI_DA=5
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
POS_DIEM_MOI_DONG=100000
POS_GIA_TRI_DIEM=1000
POS_HAN_TRA_NGAY=7
POS_NGUONG_TRA_KHONG_DUYET=500000
# Đặt hàng online: hạn giữ QR 30 phút, pickup 4 giờ (gia hạn tối đa 24 giờ); trần giữ pickup 50% tồn gốc mỗi sản phẩm.
# Chống ôm hàng (D12): tối đa 3 đơn mở/SĐT, 10 sản phẩm khác nhau/đơn, 10 đơn vị/dòng, 5 đơn/phút/IP.
POS_ONLINE_QR_PHUT=30
POS_ONLINE_PICKUP_GIO=4
POS_ONLINE_GIA_HAN_TOI_DA_GIO=24
POS_ONLINE_MAX_DON_MO=3
POS_ONLINE_MAX_SOLUONG=10
POS_ONLINE_MAX_SANPHAM=10
POS_ONLINE_GIU_TOI_DA_PHAN_TRAM=50
POS_ONLINE_THROTTLE_DAT=5,1
# P2 Giao tận nơi: phí giao hàng cố định (mặc định 30000), miễn phí khi tiền hàng >= ngưỡng (0 = tắt), tự động xác nhận đơn giao
POS_PHI_GIAO_HANG=30000
POS_MIEN_PHI_GIAO_TU=0
POS_ONLINE_TU_DONG_XAC_NHAN=false
# P2: Danh sách tỉnh/thành được giao (phân tách dấu phẩy, rỗng = không giới hạn)
POS_GIAO_HANG_TINH=
# Cờ bật/tắt đặt hàng online (mặc định TẮT). Chỉ bật sau khi nhân viên có màn hình xử lý đơn (P3).
POS_DAT_HANG_ONLINE_BAT=false
# Email xác nhận đơn online dùng chung cấu hình MAIL_* bên dưới; MAIL_MAILER=log chỉ ghi log,
# đổi sang smtp để gửi thật. Khách không nhập email thì không gửi (đơn vẫn tạo bình thường).
# Cờ bật hình thức giao tận nơi (chỉ có ý nghĩa khi POS_DAT_HANG_ONLINE_BAT=true)
POS_GIAO_TAN_NOI_BAT=false
# Chế độ chỉ-webhook cho instance thử nghiệm SePay qua tunnel: mọi route
# ngoài /api/webhook/thanhtoan trả 404. MẶC ĐỊNH TẮT — không bật ngoài môi trường test.
POS_CHI_CHO_WEBHOOK=false
# Hotline hỗ trợ khách hiển thị ở storefront (footer, giỏ hàng)
HOTLINE=1900 0000
# Tên cửa hàng + tagline hiển thị trên storefront, tiêu đề trang, email.
# Đổi tên chỉ cần sửa STORE_NAME — không cần sửa code/view.
STORE_NAME=PhoneShop
STORE_TITLE="Phụ kiện điện thoại chính hãng"
# Giờ hỗ trợ khách hiển thị ở footer và thanh tin cậy
STORE_GIO_LAM_VIEC="8:00 – 22:00"

# Đăng nhập Google (TÙY CHỌN — để trống ID/Secret thì nút Google tự ẩn, không lỗi).
# Cách lấy khóa: https://console.cloud.google.com/apis/credentials
#   1. Tạo project → OAuth consent screen (External) → thêm scope email, profile.
#   2. Credentials → Create Credentials → OAuth client ID → Web application.
#   3. Authorized redirect URIs: dán đúng GOOGLE_REDIRECT_URI bên dưới.
#   4. Copy Client ID / Client secret vào .env (KHÔNG commit .env).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8081/auth/google/callback

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Số ngày giữ activity_logs cho `php artisan nhatky:don-cu`
POS_NHATKY_GIU_NGAY=365

# Sao lưu CSDL bằng `php artisan sao-luu:csdl`
BACKUP_DISK=backups
BACKUP_GIU_BAN=7
BACKUP_TIMEOUT=300
# Để trống thì tìm mysqldump trong PATH; trên WAMP nên trỏ đường dẫn đầy đủ.
DB_DUMP_BINARY=

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# PIN xac nhan thao tac nhay cam (step-up, 6 so) — mac dinh TAT
POS_PIN_BAT=false
# Giam gia POS vuot nguong nay (phan tram) yeu cau PIN muc thuong (khi POS_PIN_BAT=true)
POS_GIAM_GIA_KHONG_PIN_TOI_DA=10

# Cua so xac thuc lai ho so khach sau khi nhap dung mat khau + SDT (phut, 2-30, mac dinh 10)
POS_HO_SO_CUA_SO_PHUT=10

# Kiem tra DNS (MX/A) cho email o form khach cong khai — mac dinh BAT.
# Loi mang/timeout thi cho qua (fail-open). Tat trong test (phpunit.xml).
EMAIL_KIEM_TRA_DNS=true
